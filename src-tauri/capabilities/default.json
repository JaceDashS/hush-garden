{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Window basics and HTTP requests to the jace-s API only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.jace-s.com/*"
        },
        {
          "url": "http://localhost:3100/*"
        }
      ]
    }
  ]
}
