{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hush Garden",
  "version": "0.1.0",
  "identifier": "com.jaces.hushgarden",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "npm run export:web"
  },
  "app": {
    "windows": [
      {
        "title": "Hush Garden",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A cute quarter-view garden where speakers play masking noise"
  }
}
